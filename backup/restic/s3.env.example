# Off-site copy on AWS S3. Copy to /root/.config/backup-odoo/s3.env on the server (chmod 600)
# with the real values. The keys belong to an IAM user that can ONLY use this bucket.
S3_REPO=s3:s3.us-east-1.amazonaws.com/almi-chain-backup-2026/restic
AWS_ACCESS_KEY_ID=<IAM user access key ID>
AWS_SECRET_ACCESS_KEY=<IAM user secret access key>
# Only on AWS Learner Lab (no IAM users allowed): the lab's temporary credentials also need the token.
# AWS_SESSION_TOKEN=<lab session token>
AWS_DEFAULT_REGION=us-east-1
